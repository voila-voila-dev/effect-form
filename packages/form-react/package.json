{
	"name": "@voila.dev/effect-form-react",
	"version": "0.27.0",
	"description": "React bindings for @voila.dev/effect-form",
	"type": "module",
	"publishConfig": {
		"access": "public",
		"exports": {
			"./package.json": "./package.json",
			".": "./dist/index.js",
			"./*": "./dist/*.js",
			"./internal/*": null
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": "./src/index.ts",
		"./*": "./src/*.ts",
		"./internal/*": null
	},
	"files": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/voila-voila-dev/effect-form.git"
	},
	"homepage": "https://github.com/voila-voila-dev/effect-form",
	"keywords": [
		"effect",
		"form",
		"react",
		"schema",
		"validation",
		"typescript"
	],
	"author": "Lucas Barake",
	"license": "MIT",
	"sideEffects": [],
	"dependencies": {
		"@voila.dev/effect-form": "0.27.0"
	},
	"devDependencies": {
		"@effect/atom-react": "catalog:effect",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"effect": "catalog:effect",
		"react": "catalog:react"
	},
	"peerDependencies": {
		"@effect/atom-react": ">=4.0.0-rc.112 <4.0.1",
		"effect": ">=4.0.0-rc.112 <4.0.1",
		"react": "^19.0.0"
	}
}
